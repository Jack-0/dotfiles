{
  // Avoid telemetry
  "telemetry.telemetryLevel": "off",
  "aws.telemetry": false,

  // Appearance
  "workbench.colorTheme": "One Dark Pro",
  "editor.fontFamily": "ComicCode Nerd Font, Comic Mono",
  "debug.console.fontFamily": "ComicCode Nerd Font, Comic Mono",
  "editor.fontSize": 16,
  "editor.fontLigatures": false,
  "editor.minimap.enabled": false,
  "launch": {
    "configurations": [],
    "compounds": []
  },
  "cSpell.language": "en-GB,en",
  "workbench.startupEditor": "none",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  // Vim
  "vim.leader": " ",
  // Ignore keys
  "vim.handleKeys": {
    "<C-p>": false // issues with windows fuzzy find
  },
  // Custom bindings
  // I find these bindings by going to Keyboard shortcuts (⌘k+⌘s),
  // then I click copy and paste to reveal the command 
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [" ", "c"],
      "commands": ["workbench.action.showCommands"]
    },
    {
      "before": [" ", "f"],
      "commands": ["editor.action.formatDocument"]
    },
    {
      "before": [" ", "r"],
      "commands": ["editor.action.rename"]
    },
    {
      "before": [" ", " "],
      "commands": ["workbench.action.quickOpen"]
    },
  ],

  // JSON
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "svelte.enable-ts-plugin": true,
  "cSpell.userWords": [
    "Odata",
    "OIDC"
  ],
  "extensions.ignoreRecommendations": true,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "settingsSync.ignoredSettings": [],
  "dotnetAcquisitionExtension.enableTelemetry": false,
  "gitlens.telemetry.enabled": false,
  "razor.completion.commitElementsWithSpace": false,
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "debug.console.fontSize": 16,
  "terminal.integrated.fontSize": 16,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "azureFunctions.showProjectWarning": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "svg.preview.mode": "svg",
  "go.toolsManagement.autoUpdate": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "prettier.trailingComma": "all",
  "mssql.connectionGroups": [
    {
      "name": "ROOT",
      "id": "ED9E5039-5527-46BE-8546-FABA5633E5CA"
    }
  ],
  "mssql.connections": [
    {
      "authenticationType": "SqlLogin",
      "connectTimeout": 30,
      "applicationName": "vscode-mssql",
      "applicationIntent": "ReadWrite",
      "server": "35.234.153.148",
      "database": "",
      "user": "jackharris",
      "password": "",
      "commandTimeout": 30,
      "encrypt": "Mandatory",
      "profileName": "ladmin",
      "savePassword": true,
      "trustServerCertificate": true,
      "groupId": "ED9E5039-5527-46BE-8546-FABA5633E5CA",
      "id": "DFB2FBB5-ED91-45BD-AC3B-D8CE1D540A0B",
      "profileSource": 0
    }
  ],
  "files.associations": {
    "*.tf": "opentofu"
  },
  "editor.wordWrap": "on",
  "git.suggestSmartCommit": false
}
