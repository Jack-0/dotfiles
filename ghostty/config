# Startup
# initial-command="tmux a -t base || tmux new -s base"

# options
shell-integration=zsh

# Style
title=" "
# hidden macos topbar
macos-titlebar-style=hidden 
font-family="ComicCode Nerd Font"
font-size=18
theme="TokyoNight Night"
window-width=110
window-height=55
window-padding-x=16,10
window-padding-y=10
adjust-cell-height=10

# QOL
# disable ligatures
font-feature="-dlig" 
# no warning on quite 
confirm-close-surface=false 
